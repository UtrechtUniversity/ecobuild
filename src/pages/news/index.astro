---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Newspaper, ArrowRight } from "lucide-react";

const items = (await getCollection("news"))
    .filter((item) => item.data.visible)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
    title="News"
    description="Latest news and updates from the EcoBUILD lab at Utrecht University."
>
    <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
        <!-- Hero -->
        <div class="max-w-4xl mb-16">
            <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
                EcoBUILD News
            </h1>
            <p class="text-xl text-gray-600 leading-relaxed mb-6">
                Stay up to date with the latest research findings, awards,
                publications, and events from the EcoBUILD lab at Utrecht
                University.
            </p>
            <div class="h-1 w-20 bg-blue-600 rounded-full"></div>
        </div>

        <!-- Timeline -->
        <div class="border-l-2 border-gray-100 pl-8 space-y-8 max-w-3xl">
            {
                items.map((item) => (
                    <div class="relative">
                        <span class="absolute -left-[37px] top-4 w-4 h-4 rounded-full bg-blue-100 border-2 border-white ring-1 ring-blue-600" />
                        <div class="flex gap-4 items-start">
                            <!-- Thumbnail -->
                            <div class="shrink-0 w-20 h-20 rounded-xl overflow-hidden bg-gray-50 border border-gray-100">
                                {item.data.url ? (
                                    <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="block w-full h-full hover:opacity-90 transition-opacity">
                                        {item.data.images && item.data.images.length > 0 ? (
                                            <Image
                                                src={item.data.images[0]}
                                                alt={item.data.title}
                                                class="w-full h-full object-cover"
                                                quality={70}
                                                format="webp"
                                                width={160}
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-50">
                                                <Newspaper className="w-7 h-7 text-blue-200" />
                                            </div>
                                        )}
                                    </a>
                                ) : (
                                    <>
                                        {item.data.images && item.data.images.length > 0 ? (
                                            <Image
                                                src={item.data.images[0]}
                                                alt={item.data.title}
                                                class="w-full h-full object-cover"
                                                quality={70}
                                                format="webp"
                                                width={160}
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-50">
                                                <Newspaper className="w-7 h-7 text-blue-200" />
                                            </div>
                                        )}
                                    </>
                                )}
                            </div>

                            <!-- Text -->
                            <div class="min-w-0 flex flex-col gap-0.5 flex-1">
                                <div class="flex items-baseline gap-3">
                                    <time class="text-xs font-semibold text-gray-400 shrink-0">
                                        {item.data.date.toLocaleDateString("en-US", {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric",
                                        })}
                                    </time>
                                    {item.data.url ? (
                                        <a
                                            href={item.data.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-base font-bold text-gray-900 hover:text-blue-600 transition-colors truncate"
                                        >
                                            {item.data.title}
                                        </a>
                                    ) : (
                                        <span class="text-base font-bold text-gray-900 truncate">
                                            {item.data.title}
                                        </span>
                                    )}
                                </div>
                                {item.data.summary && (
                                    <p class="text-sm text-gray-500 leading-snug line-clamp-2">
                                        {item.data.summary}
                                    </p>
                                )}
                                {item.data.url && (
                                    <div class="flex justify-end mt-1">
                                        <a
                                            href={item.data.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:underline"
                                        >
                                            Read more <ArrowRight className="w-3 h-3" />
                                        </a>
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }

            {
                items.length === 0 && (
                    <p class="text-gray-500 italic">No news yet.</p>
                )
            }
        </div>
    </div>
</Layout>
