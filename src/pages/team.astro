---
import Layout from "../layouts/Layout.astro";
import TeamCard from "../components/TeamCard.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import mycelium from "../assets/misc/mycelium.png";

const allMembers = await getCollection("team");

// Define groups based on domestic hierarchy + international standard
const groups = [
  {
    id: "pi",
    titleKey: "team.pi",
    roles: ["Principal Investigator"],
  },
  {
    id: "faculty",
    titleKey: "team.faculty",
    roles: [
      "Professor",
      "Associate Professor",
      "Assistant Professor",
      "Lecturer",
    ],
  },
  {
    id: "postdoc",
    titleKey: "team.youth_researcher",
    roles: ["Postdoc"],
  },
  {
    id: "staff",
    titleKey: "team.support",
    roles: ["Research Assistant", "Policy Advisor"],
  },
  {
    id: "phd",
    titleKey: "team.phd",
    roles: ["PhD Student"],
  },
  {
    id: "external",
    titleKey: "team.external",
    roles: ["External"],
  },
  {
    id: "master",
    titleKey: "team.master",
    roles: ["Master Student"],
  },
  {
    id: "undergrad",
    titleKey: "team.undergrad",
    roles: ["Undergraduate", "Student Assistant"],
  },
  {
    id: "alumni",
    titleKey: "team.alumni",
    roles: ["Alumni"],
  },
];

const getRolePriority = (role: string) => {
  const priorities: Record<string, number> = {
    "Principal Investigator": 0,
    Professor: 1,
    "Associate Professor": 2,
    "Assistant Professor": 3,
    Lecturer: 4,
    Postdoc: 5,
    "Research Assistant": 6,
    "PhD Student": 7,
    "Master Student": 8,
    "Student Assistant": 9,
    Undergraduate: 10,
    Alumni: 11,
    External: 12,
    "Policy Advisor": 13,
  };
  return priorities[role] ?? 99;
};

// Group members
const groupedMembers = groups.reduce(
  (acc, group) => {
    const members = allMembers
      .filter((m) => group.roles.includes(m.data.role))
      .sort((a, b) => {
        // Sort by Role Priority first (e.g. Prof before Assoc Prof)
        const roleDiff =
          getRolePriority(a.data.role) - getRolePriority(b.data.role);
        if (roleDiff !== 0) return roleDiff;
        // Then by weight
        return (a.data.weight || 100) - (b.data.weight || 100);
      });

    if (members.length > 0) {
      acc.push({
        ...group,
        members,
      });
    }
    return acc;
  },
  [] as Array<{
    id: string;
    titleKey: string;
    roles: string[];
    members: typeof allMembers;
  }>,
);
---

<Layout
  title="Team"
  description="Meet the researchers and students behind EcoBuild, focusing on sustainable and regenerative building design at Utrecht University."
>
  <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h1
        class="text-4xl font-bold text-gray-900 mb-4"
        data-i18n-key="team.title"
      >
        Our Team
      </h1>
      <p class="text-lg text-gray-600" data-i18n-key="team.subtitle">
        Meet the people behind our innovations.
      </p>
    </div>

    <!-- Collaboration & Co-creation Section -->
    <div class="mb-20">
      <div
        class="bg-gray-50 rounded-3xl p-8 md:p-12 border border-gray-100 shadow-sm"
      >
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-6">
              Collaboration & Co-creation
            </h2>
            <div class="space-y-4 text-gray-600 text-lg leading-relaxed">
              <p>
                We believe that tackling the complex challenges of
                sustainability requires a collective effort. We actively
                collaborate and co-create with our partners, researchers, and
                local communities to develop evidence-based solutions that
                foster regenerative environments. By bridging diverse expertise,
                we ensure our research translates into real, meaningful impact.
              </p>
            </div>
            <div class="mt-8 pt-6 border-t border-gray-200">
              <p class="text-xs text-gray-500 italic">
                Graph provided by the Transdisciplinary Competencies team:
                <br />
                Jonas Torrens, Copernicus Institute, Utrecht University;<br />
                Anke de Vrieze, Centre for Unusual Collaborations; <br />
                Vanessa Timmer, Pathways to Sustainability, Utrecht University; <br
                />
                Corinne Lamain, Formerly: Centre for Unusual Collaborations
              </p>
            </div>
          </div>
          <div class="relative group">
            <div
              class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"
            >
            </div>
            <div
              class="relative bg-white rounded-2xl overflow-hidden shadow-lg"
            >
              <Image
                src={mycelium}
                alt="Mycelium Network - Symbol of Collaboration"
                class="w-full h-auto object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-20">
      {
        groupedMembers.map((group) => (
          <section>
            <h2
              class="text-2xl font-bold text-gray-900 mb-8 pl-4 border-l-4 border-blue-600"
              data-i18n-key={group.titleKey}
            >
              {/* Fallback text if JS doesn't replace it immediately, though i18n script should handle it */}
              {group.id === "pi"
                ? "Project Coordinator"
                : group.id === "faculty"
                  ? "Faculty"
                  : group.id === "postdoc"
                    ? "Researchers"
                    : group.id === "staff"
                      ? "Policy Advisors"
                      : group.id === "external"
                        ? "External Team"
                        : group.id === "phd"
                          ? "PhD Students"
                          : group.id === "master"
                            ? "Master Students"
                            : group.id === "undergrad"
                              ? "Students"
                              : group.id === "alumni"
                                ? "Alumni"
                                : ""}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
              {group.members.map((member) => (
                <TeamCard member={member} />
              ))}
            </div>
          </section>
        ))
      }

      {
        allMembers.length === 0 && (
          <p
            class="text-gray-500 text-center py-12"
            data-i18n-key="team.noMembers"
          >
            No team members found. Add markdown files to src/content/team/
          </p>
        )
      }
    </div>
  </div>
</Layout>
