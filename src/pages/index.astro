  <!-- Partners Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-8">Our Partners</h2>

      <script is:inline>
        function scrollPartners(direction) {
          const container = document.getElementById("partners-scroll");
          if (!container) return;
          const scrollAmount = container.clientWidth * 0.75 * direction;
          container.scrollBy({ left: scrollAmount, behavior: "smooth" });
        }
      </script>

      <div class="relative">
        <!-- Left / Right buttons - only show if 5+ partners -->
        {
          partners.length >= 5 && (
            <>
              <button
                aria-label="Scroll partners left"
                type="button"
                onclick="scrollPartners(-1)"
                class="absolute -left-2 top-1/2 -translate-y-1/2 z-20 bg-white border border-gray-200 rounded-full p-2 shadow-sm hover:shadow-md hidden md:inline-flex cursor-pointer"
              >
                <ArrowRight className="w-5 h-5 rotate-180 text-gray-600" />
              </button>
              <button
                aria-label="Scroll partners right"
                type="button"
                onclick="scrollPartners(1)"
                class="absolute -right-2 top-1/2 -translate-y-1/2 z-20 bg-white border border-gray-200 rounded-full p-2 shadow-sm hover:shadow-md hidden md:inline-flex cursor-pointer"
              >
                <ArrowRight className="w-5 h-5 text-gray-600" />
              </button>
            </>
          )
        }

        <!-- Scroll container -->
        <div
          id="partners-scroll"
          class="flex gap-8 overflow-x-auto scroll-smooth pb-4 px-2 md:px-0"
        >
          {
            partners.map((partner) => (
              <div class="w-[180px] sm:w-[200px] md:w-[220px] lg:w-[240px] flex-shrink-0">
                <PartnerCard partner={partner} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ caseStudies }}>
    const modal = document.getElementById("study-modal");
    const modalContent = document.getElementById("modal-content");
    const modalTitle = document.getElementById("modal-title");
    const modalLocation = document.getElementById("modal-location");
    const modalText = document.getElementById("modal-text");
    const modalTags = document.getElementById("modal-tags");

    window.openCaseStudy = (id) => {
      const study = caseStudies.find((s) => s.id === id);
      if (!study) return;

      modalTitle.innerText = study.title;
      modalLocation.innerText = study.location;
      modalText.innerText = study.fullContent;

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      // Trigger animation
      setTimeout(() => {
        modalContent.classList.remove("scale-95", "opacity-0");
        modalContent.classList.add("scale-100", "opacity-100");
      }, 10);

      // Disable scroll
      document.body.style.overflow = "hidden";
    };

    window.closeModal = () => {
      modalContent.classList.remove("scale-100", "opacity-100");
      modalContent.classList.add("scale-95", "opacity-0");

      setTimeout(() => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "auto";
      }, 300);
    };

    // Close on backdrop click
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  </script>
</Layout>
